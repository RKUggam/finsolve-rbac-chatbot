# ==========================================================================
# FinSolve RBAC RAG Chatbot — environment configuration
# Copy to `.env` and fill in the values. NEVER commit a real .env file.
# ==========================================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO
# Secret used to sign JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Azure OpenAI (chat + embeddings) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment (NOT model) names as created in Azure OpenAI Studio:
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Embedding vector dimension (3-large=3072, 3-small=1536, ada-002=1536):
EMBEDDING_DIM=3072

# ---- Generation parameters ----
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Milvus vector store ----
MILVUS_URI=http://localhost:19530     # Zilliz Cloud: https://<id>.api.<region>.zillizcloud.com
MILVUS_TOKEN=                         # Zilliz Cloud API key / user:password; empty for local
MILVUS_COLLECTION=finsolve_documents
MILVUS_DB_NAME=default

# ---- RAG / retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
DATA_DIR=data

# ---- Cost monitoring ----
# USD per 1K tokens for the chosen chat deployment (Azure gpt-4o example):
COST_INPUT_PER_1K=0.0025
COST_OUTPUT_PER_1K=0.010
COST_EMBEDDING_PER_1K=0.00013
# Raise an alert (log WARNING + optional webhook) when cumulative daily cost
# exceeds this many USD, or a single request exceeds the per-request cap:
COST_DAILY_BUDGET_USD=25.0
COST_PER_REQUEST_ALERT_USD=0.25
COST_ALERT_WEBHOOK_URL=               # optional Slack/Teams incoming webhook

# ---- Guardrails ----
GUARDRAILS_PII_ENABLED=true
GUARDRAILS_SCOPE_ENABLED=true

# ---- Observability / tracing (optional; LangSmith) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finsolve-rbac-chatbot
